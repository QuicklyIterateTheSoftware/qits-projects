<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.wohlben.qits</groupId>
        <artifactId>qits-projects</artifactId>
        <version>2026.802.181440</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- The projects DOMAIN: the Project aggregate, the Repository entity and its bare origin on
         disk, name aliases, the submodule graph, remote-login sessions, .qits-config.yml ingestion,
         and the ports this context reaches the rest of the application through. A plain library jar
         in the shape of the monorepo's `artifacts`/`ci`/`epics` modules — NO web, NO JAX-RS, NO
         websockets; those live in the sibling `service` module.

         It owns its OWN named datasource + persistence unit + Flyway lineage (a separate H2 under
         ~/.qits/data/projects, see src/main/resources/META-INF/microprofile-config.properties),
         squashed from the monorepo's V1..V45 shared lineage. The Project↔Repository↔RepositoryName↔
         RepositorySubmodule relations are REAL JPA relations with real foreign keys — all four
         tables are owned here, in one database. Everything OUTSIDE it (workspaces, commands,
         agents, technical processes) is reached by String id through a `control/` port, never a
         join. -->
    <artifactId>qits-projects-domain</artifactId>
    <name>qits-projects :: domain</name>

    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm-panache</artifactId>
        </dependency>
        <dependency>
            <!-- ObjectMapper bean for the repository metadata sidecars (no REST needed). -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-h2</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-validator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
        <dependency>
            <!-- Parses the repository's committed .qits-config.yml into plain config records. This
                 is repository content, not app config, so it is read straight from the bare origin
                 (no Quarkus config machinery). Version is managed by the Quarkus BOM. -->
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>
        <!-- NO pty4j. The interactive remote-login session still needs a real TTY so `git push` can
             prompt for credentials; it gets one from ForeignPty, six libc calls through
             java.lang.foreign, with the child put on the slave device by setsid. pty4j was
             JNA plus per-platform native libraries unpacked from its own jar at runtime — none of
             which a GraalVM native image can resolve at build time, and the failure would have
             landed on the first sign-in in the binary while this suite stayed green. See
             ForeignPty's javadoc; qits-workspace-daemon made the same call for the same reason. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- ForeignPtyTest and RemoteLoginSessionTest open real pseudo-terminals, which
                         means java.lang.foreign downcalls — restricted methods that warn on every
                         call without this and are documented to become an error in a later release.
                         The native image resolves native access at build time and needs nothing;
                         this is only the JVM path. Same flag qits-workspace-daemon's PTY modules
                         set; see service/src/main/resources/application.properties for why a runner
                         jar cannot set it for itself. -->
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
            <plugin>
                <!-- Index the jar so a consuming app discovers its CDI beans and entities without
                     needing a quarkus.index-dependency entry. -->
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <!-- A test-jar, so the `service` module's suite reuses this module's test support
                     (GitFixtures, RepoDataDirReset, and the InMemoryProcessRegistry /
                     RecordingWorkspaceLifecycle port implementations) instead of carrying a second
                     copy of each.

                     All test CLASSES ship, none of the test RESOURCES. Filtering classes out is
                     what does not work: Quarkus builds its Jandex index of a reactor dependency
                     from target/test-classes while the classpath resolves to this jar, so a jar
                     narrower than the directory yields ClassNotFoundException for whatever the
                     index saw and the jar dropped. The resources must go the other way — a second
                     application.properties / junit-platform.properties on service's test classpath
                     is a config-source collision. -->
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                        <configuration>
                            <excludes>
                                <exclude>application.properties</exclude>
                                <exclude>junit-platform.properties</exclude>
                                <exclude>META-INF/services/**</exclude>
                                <exclude>fixtures/**</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
