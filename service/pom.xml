<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.wohlben.qits</groupId>
        <artifactId>qits-projects</artifactId>
        <version>2026.825.143805</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- The projects SERVICE layer: the technical half. JAX-RS route definitions for projects,
         repositories, submodules and epics, the MCP tool surface over them, the remote-login
         terminal websocket, and the exception mapper that turns this context's DomainException into
         its HTTP status. Everything that needs a web stack and therefore cannot live in `domain`.

         A DEPLOYABLE APP, not a library JAR. It was extracted as a library — "a consuming Quarkus
         application pulls it in and gets the routes" — because packaging it would have needed an
         auth variant, a webui and a main class. All three reasons have lapsed: authentication
         terminates at qits-gateway and this module reads a header (see security/), Quarkus supplies
         the main class, and the webui is qits-spa-projects — a submodule at src/main/webui that
         Quinoa builds into this artifact.

         src/main/resources/application.properties now exists and is THIS APP's config, not a
         consuming one's. quarkus.rest.path and the MCP root-path used to live only in the test
         resources, which is why the suite could be green about paths the packaged app would not
         have served.

         See migration-deployables-plan.md in the superproject. -->
    <artifactId>qits-projects-service</artifactId>
    <name>qits-projects :: service</name>
    <packaging>quarkus</packaging>

    <dependencies>
        <dependency>
            <!-- /<segment>/q/health/ready - the readiness endpoint qits-cd's health gate curls;
                 the deployment convention every service answers. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-projects-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-projects-epics</artifactId>
        </dependency>
        <dependency>
            <!-- The vendored projects-daemon wire contract, spoken by the agent harness in
                 agenthost/. Sources, not a published jar — see that module's pom. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-projects-daemon-protocol</artifactId>
        </dependency>
        <dependency>
            <!-- The workspace daemon's wire contract, vendored: what a refinement container's
                 dial-home speaks (refinementhost/). Sources, not a published jar. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-projects-workspace-daemon-protocol</artifactId>
        </dependency>
        <dependency>
            <!-- The platform event bus. It arrives HERE and not in `domain` on purpose, twice over:
                 `bus/` is an inbound adapter like `api/` and `wiring/`, and this jar brings a THIRD
                 datasource with its own Flyway lineage — putting it on domain's classpath would make
                 every one of that module's @QuarkusTests boot an outbox they have no use for.

                 IT ADDS A MANDATORY DEPLOYMENT RESOURCE. `.config/qits/deployments.yml` declares
                 `postgresql:eventstream:qits_projects_eventstream` for it; the jar's own shipped
                 defaults map QITS_RESOURCE_EVENTSTREAM_* onto quarkus.datasource.eventstream.*, and
                 an unset variable leaves the expression unresolvable so the process refuses to boot
                 rather than opening some fallback store. Being dark in %test does not change that:
                 qits.eventstream.enabled=false stops publishing, sweeping and dialling, never the
                 datasource — hence the third database in ServiceEmbeddedPgConfigSource. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-eventstream</artifactId>
        </dependency>
        <dependency>
            <!-- The git host's event vocabulary: the four SCM records bus/ScmBackupTriggerListener
                 subscribes to. Declared explicitly rather than taken transitively through the bus,
                 because this module uses the classes by name (the signature set and the reflection
                 registration both spell them) and a compile-time use belongs in the pom that makes
                 it. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-githost-events</artifactId>
        </dependency>
        <dependency>
            <!-- The orchestrator's client jar: how this service starts, stops and lists project
                 agent containers now that it holds no docker socket. A client rather than a
                 vocabulary, so "Adding a dependency on another context" in CLAUDE.md has to be read
                 against it — and the answer is the one the eventstream jar already gets: this is
                 PLATFORM INFRASTRUCTURE, not another bounded context's SDK. No domain model
                 crosses (images, environment and lifetimes, never a Project), every call is
                 synchronous, bounded and CANNOT THROW, and the jar brings no framework at all.

                 A native consumer owes the wire records a registration:
                 containershost/ContainersWireReflection, the second member of
                 bus/EventWireReflection's family and there for the identical reason. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-containers-client</artifactId>
        </dependency>
        <dependency>
            <!-- The credential the client above presents. qits-containers guards every route —
                 reads included — on the caller's own identity: its OwnerGuard compares the token's
                 `sub` to the owner in the path, so quarkus.oidc-client.client-id is not a label
                 here, it IS this service's owner string.

                 Shipped OFF: quarkus.oidc-client.client-enabled is false in
                 application.properties, so the extension builds a disabled client, this process
                 boots with no secret and dials nothing, and the calls go out bare — which is what
                 the orchestrator's own gate (qits.auth.machine.required, also off) expects. This
                 The sibling quarkus-oidc dependency validates the commissioned agent's inbound
                 control socket; these are independent client and resource-server directions. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-oidc-client</artifactId>
        </dependency>
        <dependency>
            <!-- The project agent dials this service directly on qits-net. Its control WebSocket is
                 protected by qits:system, so the commissioned Bearer must become a validated
                 SecurityIdentity here rather than relying on browser forward-auth at the edge. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-oidc</artifactId>
        </dependency>
        <dependency>
            <!-- PatientPgDriver. It arrives transitively through `domain` and `epics` too, and is
                 declared here because THIS module's application.properties names it as well — for
                 the eventstream datasource the bus jar brings, whose own defaults do not carry the
                 baseline yet. A config key naming a class belongs in the pom that spells it. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-db-core</artifactId>
        </dependency>
        <dependency>
            <!-- domain's test-support only (see its jar plugin config): the port implementations
                 this module's @QuarkusTests need on the classpath, not a second copy of them. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-projects-domain</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <!-- OTLP export to qits-observability. The extension is what instruments the process;
                 the endpoint and protocol in application.properties are what make it arrive, since
                 the defaults are gRPC to localhost:4317 and the receiver speaks HTTP/protobuf. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <!-- Multi/BroadcastProcessor: the per-project SSE fan-out (ProjectEventBroadcaster).
                 quarkus-rest already drags Mutiny in, but the fan-out is written against it
                 directly, so it is declared rather than inherited. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-mutiny</artifactId>
        </dependency>
        <dependency>
            <!-- The hourly backup sweep (ScheduledBackupSweep). A first-class Quarkus extension, so
                 it registers its own native-image configuration: the scheduled method is discovered
                 and wired at BUILD time, which is exactly why an @Scheduled bean survives into the
                 binary while a reflective scheduler would not. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-scheduler</artifactId>
        </dependency>
        <dependency>
            <!-- The remote-login terminal socket (@WebSocket .../remote-login/{token}). -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-websockets-next</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-validator</artifactId>
        </dependency>
        <dependency>
            <!-- The agent-container reverse proxy (agenthost/ContainerProxyRoute). Quarkus drags
                 vertx-core in, but not the proxy: HttpProxy.reverseProxy lives here and nothing
                 else on the classpath pulls it. The raw routes beside it need only vertx-core. -->
            <groupId>io.vertx</groupId>
            <artifactId>vertx-http-proxy</artifactId>
        </dependency>
        <dependency>
            <!-- The repository/submodule MCP tool surface. Not in the Quarkus BOM, so the version
                 is pinned explicitly. 2.0 speaks the stateless MCP 2026-07-28 protocol and CR2 is
                 built against Quarkus 3.33.x (~ 3.34.6). -->
            <groupId>io.quarkiverse.mcp</groupId>
            <artifactId>quarkus-mcp-server-http</artifactId>
            <version>2.0.0.CR2</version>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.mcp</groupId>
            <artifactId>quarkus-mcp-server-test</artifactId>
            <version>2.0.0.CR2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- The Angular SPA in src/main/webui (a submodule on qits-spa-projects' main): Quinoa
                 runs its npm build during augmentation and registers the output as static
                 resources, so the binary serves the UI and the API from one process. Not in the
                 Quarkus BOM, so the version is pinned as the MCP one above is; 2.8.2 is what the
                 Quarkus extension registry resolves for core 3.34.6 (2.8.3 is built against
                 3.36.2). Its build needs an npm and a node on PATH — see the note in
                 application.properties. -->
            <groupId>io.quarkiverse.quinoa</groupId>
            <artifactId>quarkus-quinoa</artifactId>
            <version>2.8.2</version>
        </dependency>
        <dependency>
            <!-- SecurityIdentity (the epics controllers stamp the audit log with the caller) plus
                 the HttpAuthenticationMechanism SPI, for the single thing this service does about
                 auth: read qits-gateway's X-Qits-User header into an identity (see
                 security/ForwardAuthMechanism). NOT an auth variant and NOT an authorization
                 policy — the monolith's -Dqits.variant auth/* modules do not come here at all;
                 authentication terminates at the gateway (migration-auth-plan.md). -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-auth-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-openapi</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- @TestSecurity, so the epics audit test can name its caller. The monorepo got a
                 `dev` identity from the forwardauth auth variant; auth is unassigned
                 (migration-plan.md §4) and no auth/* module is carried here. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-test-security</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- DatasourceBaselineRules, the config half of the platform's shared rules. It lives
                 HERE and not in the entity modules because this is the only module whose config
                 sees every datasource the application deploys with — `projects`, `epics` and the
                 bus's `eventstream` — and the baseline is a property of the deployed application.
                 The ArchUnit half stays one per entity module (see ArchRulesTest there). -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-arch-rules</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- The two databases every @QuarkusTest here boots against. Zonky spawns real postgres
                 binaries as a child process — a maven dependency rather than a container — which is
                 what keeps the clone-alone, docker-free rule true now that both stores are
                 postgres. A test-scoped dependency is never transitive, so this is declared here as
                 well as in `domain`, whose test-jar supplies the EmbeddedPg class itself. -->
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-linux-amd64</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-linux-arm64v8</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-darwin-arm64v8</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <testResource>
                <!-- The committed bare git fixtures (submodule-*.git) live in the domain module's
                     test resources, which is where GitFixtures also writes the derived ones. They
                     are copied rather than pulled from domain's test-jar because git cannot clone
                     out of a jar: these have to be real directories on disk. -->
                <directory>../domain/src/test/resources</directory>
                <includes>
                    <include>fixtures/**</include>
                </includes>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <!-- This module is the DEPLOYABLE, not a library jar, and <packaging>quarkus</packaging>
                     above is what says so: it binds generate-code, generate-code-tests and build into
                     the lifecycle, so augmentation is not an execution someone can misplace. It was
                     one, right here — declared under a <build> whose <testResources> block comes
                     first — and that is the arrangement in which the goals once silently never
                     applied while `mvn verify` stayed green (migration-deployables-plan.md records
                     this module as the case that proved it). A packaging type cannot fail that way:
                     drop this <extensions>true</extensions> and the build stops at "Unknown
                     packaging: quarkus" rather than quietly producing nothing. Version comes from
                     the root pom's pluginManagement. -->
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <extensions>true</extensions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                        <configuration>
                            <systemPropertyVariables>
                                <!-- How @QuarkusIntegrationTest finds the compiled binary in a
                                     `-Dnative` build; without it the native run has nothing to
                                     launch. The binary's name is quarkus.package.output-name in
                                     application.properties, NOT the maven finalName — with an
                                     output-name set, ${project.build.finalName}-runner is a path
                                     that does not exist, so the two have to be spelled the same
                                     here or a native IT launches nothing and passes. -->
                                <native.image.path>${project.build.directory}/qits-projects</native.image.path>
                                <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- GraalVM native build (the same profile qits-gateway and qits-workspace-daemon carry):
             `-Dnative` disables the fast-jar and enables the native image. It lives in THIS module,
             not the root pom, because only this module is an application — `domain` and `epics` are
             library jars with nothing to native-compile. skipITs flips with it so a native build
             runs any @QuarkusIntegrationTest against the binary rather than skipping it silently. -->
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <quarkus.package.jar.enabled>false</quarkus.package.jar.enabled>
                <skipITs>false</skipITs>
                <quarkus.native.enabled>true</quarkus.native.enabled>
            </properties>
        </profile>
    </profiles>
</project>
