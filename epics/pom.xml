<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.wohlben.qits</groupId>
        <artifactId>qits-projects</artifactId>
        <version>2026.823.155048</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- The planning domain — epics → features → tasks + audit log (docs/epics/qits-epics/). A plain
         library jar like `domain`/`artifacts`: entities, persistence, control, mapper, dto — NO
         web/JAX-RS and, deliberately, NO dependency on `domain` or any `auth/*` module. Epics hang
         off a project and tasks off a repository by *String id* (never a JPA @ManyToOne), so the
         module stays lift-out-able. Its REST boundary is hosted (for now) by `service`. It owns its
         OWN named datasource + persistence unit + Flyway lineage — its own postgres database,
         `qits_epics`, handed to it as QITS_RESOURCE_EPICS_* (see
         src/main/resources/META-INF/microprofile-config.properties) — so the likely future
         standalone deployable moves a database, not tables out of somebody else's. -->
    <artifactId>qits-projects-epics</artifactId>
    <name>qits-projects :: epics</name>

    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm-panache</artifactId>
        </dependency>
        <dependency>
            <!-- ObjectMapper bean for serializing audit snapshots to JSON (no REST needed). -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jackson</artifactId>
        </dependency>
        <dependency>
            <!-- This module's store: its own postgres database, separate from `projects`. The two
                 datasources the deployable opens are two databases on one server, which is what
                 keeps this module lift-out-able. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-flyway</artifactId>
        </dependency>
        <dependency>
            <!-- Flyway 10 split its database support out of the core: without this module Flyway
                 refuses a postgres url with "no database found to handle". Declared here as well
                 as in `domain` because this module owns its own lineage and depends on nothing. -->
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-validator</artifactId>
        </dependency>
        <dependency>
            <!-- The causation PERSISTENCE trio only: CausedRow + CausationStamp on all four
                 entities here. This module still depends on `domain`, on `auth/*`
                 and on the bus's SEAMS not at all — three jakarta-persistence-shaped types are not
                 a publish/subscribe coupling, and a lift-out of this module takes them along in one
                 jar. Its persistence unit boots in this suite whether the bus is enabled or not,
                 so testdb/EpicsEmbeddedPgConfigSource feeds it a database of its own. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-eventstream</artifactId>
        </dependency>
        <dependency>
            <!-- PatientPgDriver, which this module's shipped defaults name as the `epics`
                 datasource's driver, and DbRetry, which control/ReadPatience wraps the board's
                 list reads in. Declared here rather than inherited: this module depends on
                 `domain` not at all, and a datasource whose driver class is missing from the
                 classpath fails at the first connect. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-db-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- The platform's shared ArchUnit rules over this module's entity package. Declared
                 here as well as in `domain` because this module owns its own entities and depends
                 on nothing — a rule enforced only over there would not see these four classes. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-arch-rules</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- The store this module's @QuarkusTests boot against: real postgres binaries spawned
                 as a child process, never a container and never a dev service. testdb/EmbeddedPg
                 is a COPY of domain's rather than a reuse — this module deliberately depends on
                 nothing, and a test-jar dependency on `domain` is the higher price. -->
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Per-arch artifacts; zonky picks one at run time, so every architecture the suite
                 may run on is named here rather than discovered mid-suite. -->
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-linux-amd64</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-linux-arm64v8</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-darwin-arm64v8</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
