<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.wohlben.qits</groupId>
        <artifactId>qits-projects</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- The projects SERVICE layer: the technical half. JAX-RS route definitions for projects,
         repositories, submodules and epics, the MCP tool surface over them, the remote-login
         terminal websocket, and the exception mapper that turns this context's DomainException into
         its HTTP status. Everything that needs a web stack and therefore cannot live in `domain`.

         A DEPLOYABLE APP, not a library JAR. It was extracted as a library — "a consuming Quarkus
         application pulls it in and gets the routes" — because packaging it would have needed an
         auth variant, a webui and a main class. All three reasons have lapsed: authentication
         terminates at qits-gateway and this module reads a header (see security/), the webui stays
         in the monorepo, and Quarkus supplies the main class.

         src/main/resources/application.properties now exists and is THIS APP's config, not a
         consuming one's. quarkus.rest.path and the MCP root-path used to live only in the test
         resources, which is why the suite could be green about paths the packaged app would not
         have served.

         See migration-deployables-plan.md in the superproject. -->
    <artifactId>qits-projects-service</artifactId>
    <name>qits-projects :: service</name>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-projects-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-projects-epics</artifactId>
        </dependency>
        <dependency>
            <!-- domain's test-support only (see its jar plugin config): the port implementations
                 this module's @QuarkusTests need on the classpath, not a second copy of them. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-projects-domain</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <!-- The remote-login terminal socket (@WebSocket .../remote-login/{token}). -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-websockets-next</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-validator</artifactId>
        </dependency>
        <dependency>
            <!-- The repository/submodule MCP tool surface. Not in the Quarkus BOM, so the version
                 is pinned as in the monorepo; 1.13.0 is built against Quarkus 3.33.x (~ 3.34.6). -->
            <groupId>io.quarkiverse.mcp</groupId>
            <artifactId>quarkus-mcp-server-http</artifactId>
            <version>1.13.0</version>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.mcp</groupId>
            <artifactId>quarkus-mcp-server-test</artifactId>
            <version>1.13.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- SecurityIdentity (the epics controllers stamp the audit log with the caller) plus
                 the HttpAuthenticationMechanism SPI, for the single thing this service does about
                 auth: read qits-gateway's X-Qits-User header into an identity (see
                 security/ForwardAuthMechanism). NOT an auth variant and NOT an authorization
                 policy — the monolith's -Dqits.variant auth/* modules do not come here at all;
                 authentication terminates at the gateway (migration-auth-plan.md). -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-openapi</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- @TestSecurity, so the epics audit test can name its caller. The monorepo got a
                 `dev` identity from the forwardauth auth variant; auth is unassigned
                 (migration-plan.md §4) and no auth/* module is carried here. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-test-security</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <testResource>
                <!-- The committed bare git fixtures (submodule-*.git) live in the domain module's
                     test resources, which is where GitFixtures also writes the derived ones. They
                     are copied rather than pulled from domain's test-jar because git cannot clone
                     out of a jar: these have to be real directories on disk. -->
                <directory>../domain/src/test/resources</directory>
                <includes>
                    <include>fixtures/**</include>
                </includes>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <!-- This module is the DEPLOYABLE, not a library jar. Augmentation is what produces
                     target/quarkus-app/quarkus-run.jar; without this execution `mvn verify` proves
                     the tests pass and proves nothing about whether the thing starts. Version comes
                     from the root pom's pluginManagement. -->
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
