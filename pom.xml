<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Standalone parent for the extracted qits-projects repo (docs/epics/qits-projects in the qits
         monorepo). The PROJECT + REPOSITORY + PLANNING context: the Project aggregate and its slug,
         the git-remote-as-entity half of domain.repository (bare origins on disk, clone/pull/push/
         sync, submodule graph, name aliases, remote-login credentials), and the epics planning
         module. Everything workspace-shaped — the Workspace entity, containers, file access,
         framework detection, prompt drafts — belongs to qits-workspaces and is deliberately absent,
         as is everything that runs inside a container (qits-workspace-daemon).

         DELIBERATELY ITS OWN GAV, the qits-workspaces case rather than the qits-workspace-daemon
         one. The child directories are `domain`, `service` and `epics`, whose monorepo artifactIds
         are the bare `domain`/`epics` — installing eu.wohlben:domain:1.0.0-SNAPSHOT from here would
         clobber the monorepo's jar in the shared ~/.m2 that every workspace container mounts. The
         directories stay as they are (the filtered history is anchored to them); only the
         coordinates are namespaced, and the artifactIds are named by layer.

         Versions that must stay in step with qits (Quarkus platform, JDK release, MapStruct, Lombok)
         are duplicated here on purpose: a clone of THIS repo alone must build, with no monorepo and
         no parent to inherit from.

         Trimmed to what these modules actually need. The monorepo's app-wide machinery is
         intentionally omitted: spotless, the :8080 dev-mode port guard, the 15-way isolated-test
         surefire chunking, enforcer, the derive-fixture-bares antrun step (this repo builds its git
         fixtures in-test instead — see domain's GitFixtures), the maven build-cache extension, and
         the mandatory -Dqits.variant=oauth|forwardauth|local auth profiles. -->
    <groupId>eu.wohlben.qits</groupId>
    <artifactId>qits-projects</artifactId>
    <version>2026.903.215508</version>
    <packaging>pom</packaging>
    <name>qits-projects</name>

    <modules>
        <!-- gitmirror has no reactor dependency and is what `domain` builds its git substrate from
             (see its own pom for why it is a separate module); `service` depends on both `domain`
             and `epics`; `epics` deliberately depends on neither. projects-daemon-protocol is a
             vendored copy of the daemon repo's wire contract and depends on nothing at all. -->
        <module>gitmirror</module>
        <module>projects-daemon-protocol</module>
        <module>workspace-daemon-protocol</module>
        <module>domain</module>
        <module>epics</module>
        <module>service</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.version>3.34.6</quarkus.platform.version>

        <!-- Embedded PostgreSQL for the suites. Both stores ARE postgres now, so every test that
             touches SQL has to run against one — and the first rule here is that a clone tests
             green with NO DOCKER, which rules out Testcontainers and Quarkus dev services alike.
             Zonky resolves real postgres binaries as ordinary Maven artifacts and spawns them as a
             child process: a maven dependency, not a container.

             Two coordinates, on purpose. The BOM pins which POSTGRES the binaries are (18.4.0 —
             the platform's own postgres tag), the library version is the harness around them, and
             they move independently. Every architecture the suite may run on is named explicitly
             in the modules that use it: the binaries are per-arch artifacts, and a missing one
             fails at test time rather than at resolution. -->
        <zonky.embedded-postgres.version>2.2.2</zonky.embedded-postgres.version>
        <zonky.postgres-binaries.version>18.4.0</zonky.postgres-binaries.version>

        <compiler-plugin.version>3.15.0</compiler-plugin.version>
        <surefire-plugin.version>3.5.4</surefire-plugin.version>
        <failsafe-plugin.version>3.5.4</failsafe-plugin.version>
        <jandex-plugin.version>3.4.0</jandex-plugin.version>
        <jar-plugin.version>3.4.2</jar-plugin.version>
        <lombok.version>1.18.38</lombok.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <mapstruct.version>1.6.3</mapstruct.version>

        <!-- The platform event bus: the outbox, the idempotent PUT, the durable listener and
             CausationScope. Published by libs/qits-eventstream into the platform Maven repository,
             which is the whole reason the <repositories> block below exists — these two are the only
             dependencies here that are neither on Maven Central nor built in this reactor.

             qits-githost-events is the git host's VOCABULARY and nothing else: four records
             (SCMPublishCommit, SCMPublishTag, SCMDeleteBranch, SCMDeleteTag) plus their dependency
             on the bus. Depending on it buys the event names this service listens for and no part of
             the git host itself — which is why that repository splits it out as its own module.

             THE VOCABULARY JAR CARRIED 1.0.0-SNAPSHOT UNTIL 2026-08-12, and the snapshot worked for
             months without ever being released: the bootstrap seed-published it into the registry,
             which is not a release and does not survive the artifacts store being re-seeded without
             it. Nothing went red at the time, because every build after that re-seed reused docker's
             cached maven layer — so the resolution the pin governs was never actually performed. A
             green build that resolved nothing is not evidence that it could, which is the whole
             reason to name a release here. qits-githost cut one on 2026-08-12 and this is it. -->
        <qits.eventstream.version>2026.903.85121</qits.eventstream.version>
        <qits.githost-events.version>2026.820.65553</qits.githost-events.version>

        <!-- qits-containers' client jar: the orchestrator that owns every container this service
             starts, now that it holds no docker socket. Framework-free — one class, four answers,
             no arc and no OIDC extension — which is what lets service/ produce it as a bean in
             three lines.

             PINNED AT A RELEASED CALVER, never a snapshot, for the reason spelled out above the
             vocabulary jar: a snapshot that resolves only from a warm docker layer and a
             developer's ~/.m2 is a red release waiting for whoever next edits a file. -->
        <qits.containers-client.version>2026.903.205602</qits.containers-client.version>

        <!-- qits-integrations-quarkus ships two jars this repo consumes, released together, so they
             carry ONE version property rather than drifting apart:

               qits-arch-rules  the platform's shared ArchUnit rules plus the datasource-baseline
                                config assertion, test scope wherever they are declared;
               qits-db-core     PatientPgDriver (named by config on every postgresql datasource) and
                                DbRetry — the read seams that must survive a postgres cutover, and
                                since 2026.811.165001 `inNewTx`, which opens the transaction of a
                                write seam so an attempt that certainly did not commit can be made
                                again.

             The version moves with that repository rather than with the eventstream jar the rules
             judge — deliberately, since the rules name every type they judge as a string and depend
             on neither. -->
        <qits.integrations-quarkus.version>2026.902.53026</qits.integrations-quarkus.version>

        <!-- The user-story framework (test scope): every *IT under service/src/test/.../stories/
             is a userflow, plus TokenValidationBootstrapIT, so a run of them regenerates
             service/target/userstories/ — the proof doubling as documentation, network diagram
             included. The diagram is not narrated: traffic is OBSERVED (the framework's own
             RestAssured tap on this side; MockIdp's recordings and the git host fixture's access
             log on the other) and drained into each story's report at story end.

             THIS VERSION is the one that SHIPS the RestAssured tap — NetworkTaps.restAssured —
             which four repositories had each hand-copied as a local StoryNetworkFilter; that copy
             is deleted here rather than kept in step. It carries its OWN version rather than riding
             qits.integrations-quarkus.version above, because it is released out of
             libs/qits-userflows and not out of that reactor. -->
        <qits.userflows.version>2026.902.53027</qits.userflows.version>
        <!-- The recording service mocks the same IT boots against (the generic MockService plus
             idp.MockIdp), released out of libs/qits-integrations-quarkus like qits-arch-rules and
             qits-db-core above — so the same-string policy applies the day this repo consumes a
             newer reactor, and until then it names the release the mock idp actually shipped in. -->
        <qits.service-mock.version>2026.902.53026</qits.service-mock.version>
        <qits.maven.repository.url>http://registry.dev.localhost:8080/artifacts/maven/maven</qits.maven.repository.url>

        <!-- The container ITs need docker and a built qits/workspace image, which a fresh clone has
             not got — and the ones that survived the cut here are the MCP/task-prompt delivery ITs
             that drive a real container. `mvn verify` must be green without them. -->
        <skipITs>true</skipITs>
        <!-- Surefire's @{argLine} has no value unless something (jacoco/quarkus) sets it. -->
        <argLine/>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <!-- Which postgres the embedded binaries ARE — 18.4.0, the tag the platform's own
                     qits-oci-postgresql image is built from, so the suites meet the same server
                     version a deployment does. Imported as a BOM because the per-arch artifacts
                     are separate coordinates. -->
                <groupId>io.zonky.test.postgres</groupId>
                <artifactId>embedded-postgres-binaries-bom</artifactId>
                <version>${zonky.postgres-binaries.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.zonky.test</groupId>
                <artifactId>embedded-postgres</artifactId>
                <version>${zonky.embedded-postgres.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <!-- The platform jars this repo consumes. -->
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-eventstream</artifactId>
                <version>${qits.eventstream.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-githost-events</artifactId>
                <version>${qits.githost-events.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-containers-client</artifactId>
                <version>${qits.containers-client.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-auth-core</artifactId>
                <version>${qits.integrations-quarkus.version}</version>
            </dependency>
            <dependency>
                <!-- Test scope at every declaration site: the rules run in the build and ship in
                     nothing. -->
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-arch-rules</artifactId>
                <version>${qits.integrations-quarkus.version}</version>
            </dependency>
            <dependency>
                <!-- Compile scope, and it ships: PatientPgDriver is named by config on every
                     postgresql datasource, so the class has to be on the runtime classpath of any
                     module whose datasource names it. -->
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-db-core</artifactId>
                <version>${qits.integrations-quarkus.version}</version>
            </dependency>
            <dependency>
                <!-- Test scope at every declaration site, like qits-arch-rules. -->
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-userflows</artifactId>
                <version>${qits.userflows.version}</version>
            </dependency>
            <dependency>
                <!-- Test scope at every declaration site, like qits-arch-rules. -->
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-service-mock</artifactId>
                <version>${qits.service-mock.version}</version>
            </dependency>
            <!-- The reactor's own modules, so children depend on them version-less. -->
            <dependency>
                <!-- The git substrate: mirrors, wire reads and pushes. Framework-free like the
                     domain/epics entries beside it, so `domain` gets a library and not a second CDI
                     graph. -->
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-projects-gitmirror</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <!-- The vendored projects-daemon wire contract. Framework-free like gitmirror, and
                     consumed only by `service` — the agent harness is a service-layer concern. -->
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-projects-daemon-protocol</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <!-- The vendored WORKSPACE-daemon wire contract — the daemon a refinement
                     container runs, unchanged. Same shape as the sibling above. -->
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-projects-workspace-daemon-protocol</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-projects-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-projects-epics</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-projects-domain</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <repositories>
        <!-- The platform's own Maven repository, where qits-eventstream and qits-githost-events are
             published. The id is what a locally cached copy is recorded under, so it has to stay
             `qits-maven` or an offline build refuses an artifact it already has. -->
        <repository>
            <id>qits-maven</id>
            <url>${qits.maven.repository.url}</url>
        </repository>
    </repositories>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>${quarkus.platform.group-id}</groupId>
                    <artifactId>quarkus-maven-plugin</artifactId>
                    <version>${quarkus.platform.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${compiler-plugin.version}</version>
                    <configuration>
                        <parameters>true</parameters>
                        <!-- Incremental compilation leaves stale MapStruct *Impl classes behind
                             when a mapper's shape changes; the monorepo disables it for the same
                             reason. -->
                        <useIncrementalCompilation>false</useIncrementalCompilation>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok-mapstruct-binding</artifactId>
                                <version>${lombok-mapstruct-binding.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire-plugin.version}</version>
                    <configuration>
                        <systemPropertyVariables>
                            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${failsafe-plugin.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>io.smallrye</groupId>
                    <artifactId>jandex-maven-plugin</artifactId>
                    <version>${jandex-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>make-index</id>
                            <goals>
                                <goal>jandex</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
