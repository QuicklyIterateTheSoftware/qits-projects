# Local, per-machine overrides for running qits-projects outside a container.
#
# COPY THIS FILE to `.env` (same directory, drop the .example) and edit. `.env` is gitignored;
# this one is tracked.
#
# Quarkus reads `.env` from the process's WORKING DIRECTORY at config ordinal 295 — above the
# packaged src/main/resources/application.properties (250), below real environment variables (300)
# and `-D` system properties (400). It overrides the shipped config without a rebuild, and works for
# the native binary as well as the fast-jar. Working directory means the repo root if you run:
#
#     ./service/target/qits-projects
#
# Keys are ENVIRONMENT VARIABLE names, not property names: uppercase, dots and dashes to
# underscores. The payoff is that the same names work unchanged as real env vars in a container.

# --- ports ---------------------------------------------------------------------------------------
# quarkus.http.port. 8080 is the shipped default and every service in the split claims it.
# qits-workspaces' .env.example points its QITS_PROJECTS_URL at 8090, so the pair runs side by side
# on one host.
QUARKUS_HTTP_PORT=8090

# --- the shared on-disk contract ------------------------------------------------------------------
# qits.repositories.data-dir is the tree this service CLONES INTO, qits-artifacts serves over git
# smart-HTTP, and qits-workspaces branches from. All three must resolve it to the same place. One
# user on one host already does (~/.qits/data/repositories); set it only for an isolated scratch
# tree, and then set it identically in the others:
#
# QITS_REPOSITORIES_DATA_DIR=/tmp/qits-local/repositories

# --- the receiver a new project announces itself to -----------------------------------------------
# qits.dns.url ships as the qits-net service name, which does NOT resolve on a host. The
# announcement is fire-and-forget, so nothing breaks — creating a project still succeeds — but it
# logs a WARN a second or two later, and on a host whose resolver is slow to say NXDOMAIN that is
# the only thing those seconds are spent on. Point it at a stub, or at nothing at all:
#
# QITS_DNS_URL=http://127.0.0.1:1
#
# QITS_DNS_TOKEN is blank by default, matching qits-dns' own open mode. Set it only when the
# nameserver you are pointing at has the same value set.

# --- the self-seeded project's domain -------------------------------------------------------------
# All three or none. Unset (the default) means the seeded `qits` project is created without a domain
# and registers nothing, which is what the nullable columns exist for.
#
# QITS_STARTUP_SEED_DNS_DOMAIN=qits.eu
# QITS_STARTUP_SEED_DNS_TYPE=A
# QITS_STARTUP_SEED_DNS_VALUE=203.0.113.9
