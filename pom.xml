<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Standalone parent for the extracted qits-projects repo (docs/epics/qits-projects in the qits
         monorepo). The PROJECT + REPOSITORY + PLANNING context: the Project aggregate and its slug,
         the git-remote-as-entity half of domain.repository (bare origins on disk, clone/pull/push/
         sync, submodule graph, name aliases, remote-login credentials), and the epics planning
         module. Everything workspace-shaped — the Workspace entity, containers, file access,
         framework detection, prompt drafts — belongs to qits-workspaces and is deliberately absent,
         as is everything that runs inside a container (qits-workspace-daemon).

         DELIBERATELY ITS OWN GAV, the qits-workspaces case rather than the qits-workspace-daemon
         one. The child directories are `domain`, `service` and `epics`, whose monorepo artifactIds
         are the bare `domain`/`epics` — installing eu.wohlben:domain:1.0.0-SNAPSHOT from here would
         clobber the monorepo's jar in the shared ~/.m2 that every workspace container mounts. The
         directories stay as they are (the filtered history is anchored to them); only the
         coordinates are namespaced, and the artifactIds are named by layer.

         Versions that must stay in step with qits (Quarkus platform, JDK release, MapStruct, Lombok)
         are duplicated here on purpose: a clone of THIS repo alone must build, with no monorepo and
         no parent to inherit from.

         Trimmed to what these modules actually need. The monorepo's app-wide machinery is
         intentionally omitted: spotless, the :8080 dev-mode port guard, the 15-way isolated-test
         surefire chunking, enforcer, the derive-fixture-bares antrun step (this repo builds its git
         fixtures in-test instead — see domain's GitFixtures), the maven build-cache extension, and
         the mandatory -Dqits.variant=oauth|forwardauth|local auth profiles. -->
    <groupId>eu.wohlben.qits</groupId>
    <artifactId>qits-projects</artifactId>
    <version>2026.803.161428</version>
    <packaging>pom</packaging>
    <name>qits-projects</name>

    <modules>
        <!-- gitmirror has no reactor dependency and is what `domain` builds its git substrate from
             (see its own pom for why it is a separate module); `service` depends on both `domain`
             and `epics`; `epics` deliberately depends on neither. -->
        <module>gitmirror</module>
        <module>domain</module>
        <module>epics</module>
        <module>service</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.version>3.34.6</quarkus.platform.version>

        <compiler-plugin.version>3.15.0</compiler-plugin.version>
        <surefire-plugin.version>3.5.4</surefire-plugin.version>
        <failsafe-plugin.version>3.5.4</failsafe-plugin.version>
        <jandex-plugin.version>3.4.0</jandex-plugin.version>
        <jar-plugin.version>3.4.2</jar-plugin.version>
        <lombok.version>1.18.38</lombok.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <mapstruct.version>1.6.3</mapstruct.version>

        <!-- The container ITs need docker and a built qits/workspace image, which a fresh clone has
             not got — and the ones that survived the cut here are the MCP/task-prompt delivery ITs
             that drive a real container. `mvn verify` must be green without them. -->
        <skipITs>true</skipITs>
        <!-- Surefire's @{argLine} has no value unless something (jacoco/quarkus) sets it. -->
        <argLine/>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <!-- The reactor's own modules, so children depend on them version-less. -->
            <dependency>
                <!-- The git substrate: mirrors, wire reads and pushes. Framework-free like the
                     domain/epics entries beside it, so `domain` gets a library and not a second CDI
                     graph. -->
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-projects-gitmirror</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-projects-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-projects-epics</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-projects-domain</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>${quarkus.platform.group-id}</groupId>
                    <artifactId>quarkus-maven-plugin</artifactId>
                    <version>${quarkus.platform.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${compiler-plugin.version}</version>
                    <configuration>
                        <parameters>true</parameters>
                        <!-- Incremental compilation leaves stale MapStruct *Impl classes behind
                             when a mapper's shape changes; the monorepo disables it for the same
                             reason. -->
                        <useIncrementalCompilation>false</useIncrementalCompilation>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok-mapstruct-binding</artifactId>
                                <version>${lombok-mapstruct-binding.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire-plugin.version}</version>
                    <configuration>
                        <systemPropertyVariables>
                            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${failsafe-plugin.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>io.smallrye</groupId>
                    <artifactId>jandex-maven-plugin</artifactId>
                    <version>${jandex-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>make-index</id>
                            <goals>
                                <goal>jandex</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
