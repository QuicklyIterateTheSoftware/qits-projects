# Build output and dependency directories are per-language; add yours as the project grows.
target/
build/
dist/
out/
node_modules/

# Local environment and editor state — never committed.
.env
.env.local
.DS_Store
*.swp
.idea/
.vscode/

# The web editor's own state. The wrapper checkout IS the editor's home directory —
# openvscode-server keeps settings and extension-host state in .openvscode-server/, and the
# tooling it hosts writes .cache/ — and the /workspace volume is what makes that state survive
# a container replacement. Ignored so the editor never dirties the tree it exists to edit.
.openvscode-server/
.cache/

# Logs
*.log
